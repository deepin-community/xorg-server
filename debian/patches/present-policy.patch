+/* Optional policy hooks for native Xorg modules. The server always retains
+ * ownership of Present requests, regions, fences, notifications and cleanup.
+ */
+#define PRESENT_POLICY_ABI_VERSION 1
+
+typedef enum {
+    PRESENT_POLICY_COPY_DEFAULT = 0,
+    PRESENT_POLICY_COPY_EXECUTE = 1,
+    PRESENT_POLICY_COPY_SKIP = 2,
+    /* Retain ownership until a bounded later Copy, or truthful supersession. */
+    PRESENT_POLICY_COPY_DEFER = 3
+} PresentPolicyCopyAction;
+
+typedef enum {
+    PRESENT_POLICY_QUEUE_DEFAULT = 0,
+    PRESENT_POLICY_QUEUE_TARGET_MSC = 1
+} PresentPolicyQueueMode;
+
+typedef enum {
+    PRESENT_POLICY_DRIVER_CHECK_DEFAULT = 0,
+    PRESENT_POLICY_DRIVER_CHECK_FIRST = 1
+} PresentPolicyDriverCheckOrder;
+
+typedef struct {
+    uint32_t abi_version;
+    uint32_t struct_size;
+    PresentPolicyCopyAction (*copy_action)(WindowPtr window,
+                                           RRCrtcPtr crtc,
+                                           uint64_t crtc_msc);
+    PresentPolicyQueueMode (*queue_mode)(WindowPtr window,
+                                         RRCrtcPtr crtc,
+                                         uint64_t target_msc,
+                                         uint64_t crtc_msc);
+    PresentPolicyDriverCheckOrder (*driver_check_order)(WindowPtr window,
+                                                        RRCrtcPtr crtc);
+} PresentPolicyHooksV1;
+
+/* Query the host API before registering a module initializer. */
+extern _X_EXPORT Bool
+present_policy_query(uint32_t *abi_version, uint32_t *hooks_size);
+
+/* A single provider may register per server generation. Registration copies
+ * the hook table; the opaque provider identity is used for idempotence and
+ * matching unregister calls.
+ */
+extern _X_EXPORT Bool
+present_policy_register(const void *provider, const PresentPolicyHooksV1 *hooks);
+
+extern _X_EXPORT Bool
+present_policy_copy_defer_supported(void);
+
+extern _X_EXPORT void
+present_policy_unregister(const void *provider);
+
+/* Optional request policy is independently versioned: never extend the V1
+ * copy/queue hook table, which is also consumed by already built modules.
+ * The callback is a pure request decision and must not consume copy quota.
+ */
+#define PRESENT_POLICY_REQUEST_ABI_VERSION 1
+
+typedef struct {
+    uint32_t abi_version;
+    uint32_t struct_size;
+    Bool (*force_copy)(WindowPtr window);
+} PresentPolicyRequestHooksV1;
+
+extern _X_EXPORT Bool
+present_policy_request_query(uint32_t *abi_version, uint32_t *hooks_size);
+
+/* Register only after the same provider has registered the original hooks.
+ * present_policy_unregister/reset clears both tables atomically.
+ */
+extern _X_EXPORT Bool
+present_policy_request_register(const void *provider,
+                                const PresentPolicyRequestHooksV1 *hooks);
+
+/* Optional modifier preference: independently versioned, owned by the same
+ * provider as the original hooks. Inputs are immutable request-owned lists;
+ * a suggestion must already be present in their union. No quota is consumed.
+ */
+#define PRESENT_POLICY_MODIFIER_ABI_VERSION 1
+
+typedef struct {
+    uint32_t abi_version;
+    uint32_t struct_size;
+    Bool (*select)(WindowPtr window, CARD32 format, CARD8 depth, CARD8 bpp,
+                   CARD32 num_window, const CARD64 *window_modifiers,
+                   CARD32 num_screen, const CARD64 *screen_modifiers,
+                   CARD64 *preferred);
+} PresentPolicyModifierHooksV1;
+
+extern _X_EXPORT Bool
+present_policy_modifier_query(uint32_t *abi_version, uint32_t *hooks_size);
+
+extern _X_EXPORT Bool
+present_policy_modifier_register(const void *provider,
+                                 const PresentPolicyModifierHooksV1 *hooks);
+
+/* Internal call site used by DRI3; the caller validates membership and owns
+ * allocation/commit of any replacement reply arrays.
+ */
+extern Bool
+present_policy_select_modifier(WindowPtr window, CARD32 format,
+                               CARD8 depth, CARD8 bpp,
+                               CARD32 num_window, const CARD64 *window_modifiers,
+                               CARD32 num_screen, const CARD64 *screen_modifiers,
+                               CARD64 *preferred);
+
