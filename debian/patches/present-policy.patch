+ *
+ * Permission to use, copy, modify, distribute, and sell this software and its
+ * documentation for any purpose is hereby granted without fee, provided that
+ * the above copyright notice appear in all copies and that both that copyright
+ * notice and this permission notice appear in supporting documentation.
+ * The software is provided "as is", without warranty of any kind.
+ */
+
+#include "present_priv.h"
+
+#include <string.h>
+
+static const void *policy_provider;
+static PresentPolicyHooksV1 policy_hooks;
+static PresentPolicyRequestHooksV1 request_hooks;
+static PresentPolicyModifierHooksV1 modifier_hooks;
+
+Bool
+present_policy_query(uint32_t *abi_version, uint32_t *hooks_size)
+{
+    if (!abi_version || !hooks_size)
+        return FALSE;
+
+    *abi_version = PRESENT_POLICY_ABI_VERSION;
+    *hooks_size = (uint32_t) sizeof(PresentPolicyHooksV1);
+    return TRUE;
+}
+
+Bool
+present_policy_register(const void *provider, const PresentPolicyHooksV1 *hooks)
+{
+    if (!provider || !hooks ||
+        hooks->abi_version != PRESENT_POLICY_ABI_VERSION ||
+        hooks->struct_size < (uint32_t) sizeof(PresentPolicyHooksV1))
+        return FALSE;
+
+    if (policy_provider)
+        return policy_provider == provider;
+
+    memcpy(&policy_hooks, hooks, sizeof(policy_hooks));
+    policy_provider = provider;
+    return TRUE;
+}
+
+Bool
+present_policy_request_query(uint32_t *abi_version, uint32_t *hooks_size)
+{
+    if (!abi_version || !hooks_size)
+        return FALSE;
+
+    *abi_version = PRESENT_POLICY_REQUEST_ABI_VERSION;
+    *hooks_size = (uint32_t) sizeof(PresentPolicyRequestHooksV1);
+    return TRUE;
+}
+
+Bool
+present_policy_request_register(const void *provider,
+                                const PresentPolicyRequestHooksV1 *hooks)
+{
+    if (!provider || provider != policy_provider || !hooks ||
+        hooks->abi_version != PRESENT_POLICY_REQUEST_ABI_VERSION ||
+        hooks->struct_size < (uint32_t) sizeof(PresentPolicyRequestHooksV1))
+        return FALSE;
+
+    memcpy(&request_hooks, hooks, sizeof(request_hooks));
+    return TRUE;
+}
+
+Bool
+present_policy_modifier_query(uint32_t *abi_version, uint32_t *hooks_size)
+{
+    if (!abi_version || !hooks_size)
+        return FALSE;
+    *abi_version = PRESENT_POLICY_MODIFIER_ABI_VERSION;
+    *hooks_size = (uint32_t) sizeof(PresentPolicyModifierHooksV1);
+    return TRUE;
+}
+
+Bool
+present_policy_modifier_register(const void *provider,
+                                 const PresentPolicyModifierHooksV1 *hooks)
+{
+    if (!provider || provider != policy_provider || !hooks ||
+        hooks->abi_version != PRESENT_POLICY_MODIFIER_ABI_VERSION ||
+        hooks->struct_size < (uint32_t) sizeof(PresentPolicyModifierHooksV1))
+        return FALSE;
+    memcpy(&modifier_hooks, hooks, sizeof(modifier_hooks));
+    return TRUE;
+}
+
+Bool
+present_policy_select_modifier(WindowPtr window, CARD32 format,
+                               CARD8 depth, CARD8 bpp,
+                               CARD32 num_window, const CARD64 *window_modifiers,
+                               CARD32 num_screen, const CARD64 *screen_modifiers,
+                               CARD64 *preferred)
+{
+    return policy_provider && window && preferred && modifier_hooks.select &&
+           modifier_hooks.select(window, format, depth, bpp,
+                                 num_window, window_modifiers,
+                                 num_screen, screen_modifiers, preferred);
+}
+
+Bool
+present_policy_force_copy(WindowPtr window)
+{
+    return policy_provider && window && request_hooks.force_copy &&
+           request_hooks.force_copy(window);
+}
+
+Bool
+present_policy_copy_defer_supported(void)
+{
+    return TRUE;
+}
+
+void
+present_policy_unregister(const void *provider)
+{
+    if (provider && provider == policy_provider)
+        present_policy_reset();
+}
+
+void
+present_policy_reset(void)
+{
+    policy_provider = NULL;
+    memset(&policy_hooks, 0, sizeof(policy_hooks));
+    memset(&request_hooks, 0, sizeof(request_hooks));
+    memset(&modifier_hooks, 0, sizeof(modifier_hooks));
+}
+
+PresentPolicyCopyAction
+present_policy_copy_action(WindowPtr window, RRCrtcPtr crtc, uint64_t crtc_msc)
+{
+    PresentPolicyCopyAction action;
+
+    if (!policy_provider || !policy_hooks.copy_action)
+        return PRESENT_POLICY_COPY_DEFAULT;
+
+    action = policy_hooks.copy_action(window, crtc, crtc_msc);
+    if (action != PRESENT_POLICY_COPY_EXECUTE &&
+        action != PRESENT_POLICY_COPY_SKIP &&
+        action != PRESENT_POLICY_COPY_DEFER)
+        return PRESENT_POLICY_COPY_DEFAULT;
+
+    return action;
+}
+
+PresentPolicyQueueMode
+present_policy_queue_mode(WindowPtr window,
+                          RRCrtcPtr crtc,
+                          uint64_t target_msc,
+                          uint64_t crtc_msc)
+{
+    PresentPolicyQueueMode mode;
+
+    if (!policy_provider || !policy_hooks.queue_mode)
+        return PRESENT_POLICY_QUEUE_DEFAULT;
+
+    mode = policy_hooks.queue_mode(window, crtc, target_msc, crtc_msc);
+    if (mode != PRESENT_POLICY_QUEUE_TARGET_MSC)
+        return PRESENT_POLICY_QUEUE_DEFAULT;
+
+    return mode;
+}
+
+PresentPolicyDriverCheckOrder
+present_policy_driver_check_order(WindowPtr window, RRCrtcPtr crtc)
+{
+    PresentPolicyDriverCheckOrder order;
+
+    if (!policy_provider || !policy_hooks.driver_check_order)
+        return PRESENT_POLICY_DRIVER_CHECK_DEFAULT;
+
+    order = policy_hooks.driver_check_order(window, crtc);
+    if (order != PRESENT_POLICY_DRIVER_CHECK_FIRST)
+        return PRESENT_POLICY_DRIVER_CHECK_DEFAULT;
+
+    return order;
+}
