+#ifdef PRESENT
+/* The cache stays immutable. Repartition only complete, request-owned arrays
+ * after every check/allocation succeeds, retaining all advertised candidates.
+ */
+static void
+dri3_apply_modifier_policy(WindowPtr window, CARD32 format,
+                           CARD8 depth, CARD8 bpp,
+                           CARD32 *num_window, CARD64 **window_modifiers,
+                           CARD32 *num_screen, CARD64 **screen_modifiers)
+{
+    CARD64 preferred = DRM_FORMAT_MOD_INVALID;
+    CARD64 *new_window, *new_screen = NULL;
+    uint64_t total = (uint64_t) *num_window + *num_screen;
+    CARD32 i, next = 0, matches = 0;
+
+    if (!total || total > UINT32_MAX || total > SIZE_MAX / sizeof(CARD64) ||
+        (*num_window && !*window_modifiers) ||
+        (*num_screen && !*screen_modifiers) ||
+        !present_policy_select_modifier(window, format, depth, bpp,
+                                        *num_window, *window_modifiers,
+                                        *num_screen, *screen_modifiers,
+                                        &preferred) ||
+        preferred == DRM_FORMAT_MOD_INVALID)
+        return;
+
+    for (i = 0; i < *num_window; i++)
+        matches += (*window_modifiers)[i] == preferred;
+    for (i = 0; i < *num_screen; i++)
+        matches += (*screen_modifiers)[i] == preferred;
+    if (matches != 1 ||
+        (*num_window == 1 && (*window_modifiers)[0] == preferred))
+        return;
+
+    new_window = malloc(sizeof(CARD64));
+    if (!new_window)
+        return;
+    if (total > 1) {
+        new_screen = malloc((size_t) (total - 1) * sizeof(CARD64));
+        if (!new_screen) {
+            free(new_window);
+            return;
+        }
+    }
+    new_window[0] = preferred;
+    for (i = 0; i < *num_window; i++) {
+        if ((*window_modifiers)[i] != preferred)
+            new_screen[next++] = (*window_modifiers)[i];
+    }
+    for (i = 0; i < *num_screen; i++) {
+        if ((*screen_modifiers)[i] != preferred)
+            new_screen[next++] = (*screen_modifiers)[i];
+    }
+    free(*window_modifiers);
+    free(*screen_modifiers);
+    *window_modifiers = new_window;
+    *screen_modifiers = new_screen;
+    *num_window = 1;
+    *num_screen = next;
+}
