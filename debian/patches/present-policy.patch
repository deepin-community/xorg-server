 #include "present_priv.h"
 
+/* A hardware queue can be silently cancelled during DPMS/CRTC teardown.
+ * Only policy-deferred copies own this one-shot fallback. Neither replacement
+ * nor a retry may move the original deadline later.
+ */
+#define PRESENT_COPY_DEFER_TIMEOUT_MS 50
+
+void
+present_execute_copy_cancel_timer(present_vblank_ptr vblank)
+{
+    OsTimerPtr timer = vblank->policy_copy_timer;
+
+    vblank->policy_copy_timer = NULL;
+    if (timer)
+        TimerFree(timer);
+}
+
+void
+present_execute_copy_abort(present_vblank_ptr vblank)
+{
+    present_screen_priv_ptr screen_priv = present_screen_priv(vblank->screen);
+
+    present_execute_copy_cancel_timer(vblank);
+    /* Unlink first: an abort must not find this event if a backend notifies
+     * synchronously. xorg_list_del initializes the removed entry.
+     */
+    xorg_list_del(&vblank->event_queue);
+    vblank->queued = FALSE;
+    if (vblank->crtc && RRCrtcExists(vblank->screen, vblank->crtc)) {
+        screen_priv->abort_vblank(vblank->screen, vblank->window, vblank->crtc,
+                                  vblank->event_id, vblank->target_msc);
+    } else {
+        /* Never dereference or pass a destroyed CRTC to the DDX. */
+        vblank->crtc = NULL;
+    }
+}
+
+void
+present_execute_copy_flush(present_vblank_ptr vblank)
+{
+    uint64_t ust = GetTimeInMicros();
+    uint64_t msc = vblank->policy_copy_last_msc;
+
+    present_execute_copy_abort(vblank);
+    if (vblank->crtc) {
+        present_screen_priv_ptr crtc_priv =
+            present_screen_priv(vblank->crtc->pScreen);
+        uint64_t live_ust, live_msc;
+
+        if (crtc_priv && crtc_priv->info && crtc_priv->info->get_ust_msc &&
+            crtc_priv->info->get_ust_msc(vblank->crtc, &live_ust, &live_msc) == Success) {
+            ust = live_ust;
+            msc = live_msc;
+        }
+    }
+    /* A deferred request is already fence-ready. Its forced retry bypasses
+     * both policy and scheduling; only actual Copy may release its pixmap.
+     */
+    present_execute_copy(vblank, msc);
+    present_execute_post(vblank, ust, msc);
+}
+
+void
+present_execute_copy_discard(present_vblank_ptr vblank, uint64_t ust,
+                             uint64_t crtc_msc)
+{
+    present_execute_copy_abort(vblank);
+    present_vblank_scrap(vblank);
+    /* It was superseded, so CompleteSkip is truthful. Do not leave this
+     * record waiting for a hardware callback which DPMS may have cancelled.
+     */
+    present_execute_post(vblank, ust, crtc_msc);
+}
+
+static CARD32
+present_execute_copy_timeout(OsTimerPtr timer, CARD32 now, void *data)
+{
+    present_vblank_ptr vblank = data;
+
+    (void) now;
+    vblank->policy_copy_timer = NULL;
+    TimerFree(timer);
+    present_execute_copy_flush(vblank);
+    /* DoTimer will not touch the freed timer when the callback returns 0. */
+    return 0;
+}
+
+static Bool
+present_execute_defer_copy(present_vblank_ptr vblank, uint64_t crtc_msc)
+{
+    present_screen_priv_ptr screen_priv = present_screen_priv(vblank->screen);
+    uint64_t target = vblank->target_msc, exec = vblank->exec_msc;
+    CARD32 now = GetTimeInMillis();
+    INT32 remaining;
+
+    if (!vblank->policy_copy_defer_allowed || !vblank->crtc ||
+        !RRCrtcExists(vblank->screen, vblank->crtc))
+        return FALSE;
+
+    if (!vblank->policy_copy_deadline_valid) {
+        vblank->policy_copy_deadline_msc = crtc_msc + 1;
+        vblank->policy_copy_deadline_ms = now + PRESENT_COPY_DEFER_TIMEOUT_MS;
+        vblank->policy_copy_deadline_valid = TRUE;
+    }
+    remaining = (INT32) (vblank->policy_copy_deadline_ms - now);
+    if (remaining <= 0 ||
+        !msc_is_after(vblank->policy_copy_deadline_msc, crtc_msc))
+        return FALSE;
+
+    vblank->policy_copy_timer = TimerSet(NULL, 0, remaining,
+                                         present_execute_copy_timeout, vblank);
+    if (!vblank->policy_copy_timer)
+        return FALSE;
+    vblank->target_msc = vblank->policy_copy_deadline_msc;
+    vblank->exec_msc = vblank->target_msc;
+    vblank->policy_copy_last_msc = crtc_msc;
+    vblank->policy_copy_deferred = TRUE;
+    if (screen_priv->queue_vblank(vblank->screen, vblank->window, vblank->crtc,
+                                  vblank->event_id, vblank->exec_msc) == Success) {
+        vblank->queued = TRUE;
+        return TRUE;
+    }
+
+    present_execute_copy_cancel_timer(vblank);
+    vblank->policy_copy_deferred = FALSE;
+    vblank->target_msc = target;
+    vblank->exec_msc = exec;
+    return FALSE;
+}
