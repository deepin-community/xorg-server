+++ b/present/present_scmd.c
@@ -598,6 +598,7 @@ present_execute(present_vblank_ptr vblank, uint64_t ust, uint64_t crtc_msc)
                 } else
                     damage = &window->clipList;
 
+                DamageSetClientMark(&vblank->window->drawable);
                 DamageDamageRegion(&vblank->window->drawable, damage);
                 return;
             }
