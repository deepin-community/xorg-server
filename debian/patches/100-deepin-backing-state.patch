+void
+DamageSetClientMark(DrawablePtr pDrawable)
+{
+    DamagePtr pDmg;
+
+    drawableDamage(pDrawable);
+    for (pDmg = pDamage; pDmg; pDmg = pDmg->pNext)
+        pDmg->clientMark = TRUE;
+}
+
+static void
+_damageSetClientMarks(DrawablePtr pDrawable, Bool mark)
+{
+    DamagePtr pDmg;
+
+    drawableDamage(pDrawable);
+    for (pDmg = pDamage; pDmg; pDmg = pDmg->pNext)
+        pDmg->clientMark = mark;
+}
+
 #if DAMAGE_DEBUG_ENABLE
