 static void
+compRefreshRegion(WindowPtr pWin, RegionPtr reg)
+{
+    ScreenPtr pScreen = pWin->drawable.pScreen;
+    WindowPtr pParent = pWin->parent;
+    CompWindowPtr cw = GetCompWindow(pWin);
+    PixmapPtr pPixmap;
+    int srcx, srcy, nBox;
+    BoxPtr pBox;
+
+    if (!pParent || pWin->redirectDraw == RedirectDrawNone || !cw)
+        return;
+    pPixmap = (*pScreen->GetWindowPixmap) (pWin);
+    if (!pPixmap)
+        return;
+    nBox = RegionNumRects(reg);
+    if (!nBox)
+        return;
+    pBox = RegionRects(reg);
+    srcx = pPixmap->screen_x - pParent->drawable.x;
+    srcy = pPixmap->screen_y - pParent->drawable.y;
+
+    cw->refreshing = TRUE;
+    if (pParent->drawable.depth == pWin->drawable.depth) {
+        GCPtr pGC = GetScratchGC(pWin->drawable.depth, pScreen);
+
+        if (pGC) {
+            ChangeGCVal val;
+
+            val.val = IncludeInferiors;
+            ChangeGC(NullClient, pGC, GCSubwindowMode, &val);
+            ValidateGC(&pPixmap->drawable, pGC);
+            while (nBox--) {
+                (*pGC->ops->CopyArea) (&pParent->drawable,
+                                       &pPixmap->drawable,
+                                       pGC,
+                                       pBox->x1 + srcx, pBox->y1 + srcy,
+                                       pBox->x2 - pBox->x1, pBox->y2 - pBox->y1,
+                                       pBox->x1, pBox->y1);
+                pBox++;
+            }
+            FreeScratchGC(pGC);
+        }
+    }
+    else {
+        PictFormatPtr pSrcFormat = PictureWindowFormat(pParent);
+        PictFormatPtr pDstFormat = PictureWindowFormat(pWin);
+        XID inferiors = IncludeInferiors;
+        int error;
+        PicturePtr pSrcPicture = CreatePicture(None, &pParent->drawable, pSrcFormat,
+                                               CPSubwindowMode, &inferiors,
+                                               serverClient, &error);
+        PicturePtr pDstPicture = CreatePicture(None, &pPixmap->drawable, pDstFormat,
+                                               0, 0, serverClient, &error);
+
+        if (pSrcPicture && pDstPicture) {
+            while (nBox--) {
+                CompositePicture(PictOpSrc, pSrcPicture, NULL, pDstPicture,
+                                 pBox->x1 + srcx, pBox->y1 + srcy, 0, 0,
+                                 pBox->x1, pBox->y1,
+                                 pBox->x2 - pBox->x1, pBox->y2 - pBox->y1);
+                pBox++;
+            }
+        }
+        if (pSrcPicture)
+            FreePicture(pSrcPicture, 0);
+        if (pDstPicture)
+            FreePicture(pDstPicture, 0);
+    }
+    cw->refreshing = FALSE;
+}
+
+void
+compRefreshWindowBacking(WindowPtr pWin)
+{
+    RegionRec full;
+    BoxRec box;
+
+    box.x1 = 0;
+    box.y1 = 0;
+    box.x2 = pWin->drawable.width;
+    box.y2 = pWin->drawable.height;
+    RegionInit(&full, &box, 1);
+    compRefreshRegion(pWin, &full);
+    RegionUninit(&full);
+}
+
+static void
 compReportDamage(DamagePtr pDamage, RegionPtr pRegion, void *closure)
 {
     WindowPtr pWin = (WindowPtr) closure;
@@ -81,13 +169,41 @@ compReportDamage(DamagePtr pDamage, Regi
     CompScreenPtr cs = GetCompScreen(pScreen);
     CompWindowPtr cw = GetCompWindow(pWin);
 
-    if (!cs->pendingScreenUpdate) {
-        QueueWorkProc(compScreenUpdate, serverClient, pScreen);
-        cs->pendingScreenUpdate = TRUE;
+    if (cw->update == CompositeRedirectAutomatic) {
+        if (!cs->pendingScreenUpdate) {
+            QueueWorkProc(compScreenUpdate, serverClient, pScreen);
+            cs->pendingScreenUpdate = TRUE;
+        }
+        cw->damaged = TRUE;
+        compMarkAncestors(pWin);
+    }
+    else if (cw->update == CompositeRedirectManual && pDamage->clientMark &&
+             !cw->refreshing) {
+        BoxRec box;
+        RegionRec full, missing;
+
+        box.x1 = 0;
+        box.y1 = 0;
+        box.x2 = pWin->drawable.width;
+        box.y2 = pWin->drawable.height;
+        RegionInit(&full, &box, 1);
+        RegionUnion(&cw->clientDamage, &cw->clientDamage, pRegion);
+        RegionNull(&missing);
+        RegionSubtract(&missing, &full, &cw->clientDamage);
+        if (RegionNotEmpty(&missing)) {
+            compRefreshRegion(pWin, &missing);
+        }
+        else {
+            cw->clientFull = TRUE;
+            if (cw->damageRegistered) {
+                DamageUnregister(cw->damage);
+                cw->damageRegistered = FALSE;
+            }
+        }
+        RegionUninit(&missing);
+        RegionUninit(&full);
     }
-    cw->damaged = TRUE;
-
-    compMarkAncestors(pWin);
+    DamageEmpty(pDamage);
 }
 
