@@ -618,13 +734,15 @@ compAllocPixmap(WindowPtr pWin)
         pWin->redirectDraw = RedirectDrawManual;
 
     compSetPixmap(pWin, pPixmap, bw);
+    RegionEmpty(&cw->clientDamage);
+    cw->clientFull = FALSE;
