     cw->oldx = COMP_ORIGIN_INVALID;
     cw->oldy = COMP_ORIGIN_INVALID;
     cw->damageRegistered = FALSE;
-    if (cw->update == CompositeRedirectAutomatic) {
-        DamageRegister(&pWin->drawable, cw->damage);
-        cw->damageRegistered = TRUE;
-    }
+
+    DamageRegister(&pWin->drawable, cw->damage);
+    cw->damageRegistered = TRUE;
     status = TRUE;
 
