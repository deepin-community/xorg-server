Index: xorg-server/dix/dispatch.c
===================================================================
--- xorg-server.orig/dix/dispatch.c
+++ xorg-server/dix/dispatch.c
@@ -147,6 +147,56 @@ int ProcInitialConnection();
 int protectedWindowCount = 0;
 Window *protectedWindowList = NULL;
 
+/* Secure-input window list: when non-empty, all synthetic/injected
+ * input (XTEST fake input, XSendExtensionEvent, SendEvent of input
+ * events, XWarpPointer) is rejected with BadAccess.  Mirrors the
+ * protectedWindowList pattern.  Windows are removed automatically in
+ * FreeWindowResources so the mode can never get stuck on. */
+int secureWindowCount = 0;
+Window *secureWindowList = NULL;
+
+void
+SetSecureInputWindow(Window window)
+{
+    if (secureWindowCount >= MAXCLIENTS)
+        return;
+
+    for (int i = 0; i < secureWindowCount; i++) {
+        if (window == secureWindowList[i]) {
+            return;
+        }
+    }
+
+    int n = secureWindowCount;
+    if (secureWindowList == NULL) {
+        assert(n == 0);
+        secureWindowList = malloc(MAXCLIENTS * sizeof(Window));
+    }
+    secureWindowList[n] = window;
+    secureWindowCount++;
+}
+
+void
+RemoveSecureInputWindow(Window window)
+{
+    for (int i = 0; i < secureWindowCount; i++) {
+        if (secureWindowList[i] == window) {
+            for (int j = i; j < secureWindowCount; j++) {
+                secureWindowList[j] = secureWindowList[j + 1];
+            }
+            secureWindowList[secureWindowCount - 1] = 0;
+            secureWindowCount--;
+            return;
+        }
+    }
+}
+
+Bool
+IsSecureInputMode(void)
+{
+    return secureWindowCount > 0;
+}
+
 xConnSetupPrefix connSetupPrefix;
 
 PaddingInfo PixmapWidthPaddingInfo[33];
Index: xorg-server/dix/events.c
===================================================================
--- xorg-server.orig/dix/events.c
+++ xorg-server/dix/events.c
@@ -3675,6 +3675,11 @@ ProcWarpPointer(ClientPtr client)
     REQUEST(xWarpPointerReq);
     REQUEST_SIZE_MATCH(xWarpPointerReq);
 
+    /* Reject programmatic pointer warps while secure-input mode is
+     * active; moving the cursor programmatically is synthetic input. */
+    if (IsSecureInputMode())
+        return BadAccess;
+
     dev = PickPointer(client);
 
     for (tmp = inputInfo.devices; tmp; tmp = tmp->next) {
@@ -5582,6 +5587,17 @@ ProcSendEvent(ClientPtr client)
         client->errorValue = stuff->propagate;
         return BadValue;
     }
+    /* Reject client-injected SendEvent of input-class events while
+     * secure-input mode is active; leave other event types (WM protocol
+     * messages, ClientMessage, Selection*, Expose, etc.) unaffected so
+     * normal WM/client communication still works. */
+    if (IsSecureInputMode()) {
+        int evtype = stuff->event.u.u.type;
+        if (evtype == KeyPress || evtype == KeyRelease ||
+            evtype == ButtonPress || evtype == ButtonRelease ||
+            evtype == MotionNotify)
+            return BadAccess;
+    }
     stuff->event.u.u.type |= SEND_EVENT_BIT;
     if (stuff->propagate) {
         for (; pWin; pWin = pWin->parent) {
Index: xorg-server/dix/window.c
===================================================================
--- xorg-server.orig/dix/window.c
+++ xorg-server/dix/window.c
@@ -1028,6 +1028,10 @@ FreeWindowResources(WindowPtr pWin)
         (*pScreen->DestroyPixmap) (pWin->background.pixmap);
 
     DeleteAllWindowProperties(pWin);
+    /* Auto-remove from the secure-input window list so the mode can
+     * never get stuck on if the client (e.g. polkit) dies without
+     * explicitly clearing it. */
+    RemoveSecureInputWindow(pWin->drawable.id);
     /* We SHOULD check for an error value here XXX */
     (*pScreen->DestroyWindow) (pWin);
     DisposeWindowOptional(pWin);
Index: xorg-server/include/window.h
===================================================================
--- xorg-server.orig/include/window.h
+++ xorg-server/include/window.h
@@ -236,4 +236,10 @@ extern _X_EXPORT VisualPtr WindowGetVisual(WindowPtr /*pWin*/);
 extern _X_EXPORT void SetProtectedWindow(Window window);
 extern _X_EXPORT void RemoveProtectedWindow(Window window);
 
+/* Secure-input mode: maintained as a per-window list.  When the list is
+ * non-empty, synthetic/injected input is rejected with BadAccess. */
+extern _X_EXPORT void SetSecureInputWindow(Window window);
+extern _X_EXPORT void RemoveSecureInputWindow(Window window);
+extern _X_EXPORT Bool IsSecureInputMode(void);
+
 #endif                          /* WINDOW_H */
