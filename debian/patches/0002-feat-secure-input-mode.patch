Index: xorg-server/Xi/sendexev.c
===================================================================
--- xorg-server.orig/Xi/sendexev.c
+++ xorg-server/Xi/sendexev.c
@@ -64,6 +64,7 @@ SOFTWARE.
 
 #include "grabdev.h"
 #include "sendexev.h"
+#include "../include/window.h"  /* IsSecureInputMode() */
 
 extern int lastEvent;           /* Defined in extension.c */
 
@@ -143,6 +144,10 @@ ProcXSendExtensionEvent(ClientPtr client)
     if (ret != Success)
         return ret;
 
+    /* Reject injected extension events while secure-input mode is active. */
