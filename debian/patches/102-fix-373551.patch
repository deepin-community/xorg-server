+static Bool
+compHasViewableTransient(WindowPtr pWin)
+{
+    PropertyPtr prop;
+    WindowPtr host;
+    XID id;
+
+    if (dixLookupProperty(&prop, pWin, XA_WM_TRANSIENT_FOR, serverClient,
+                          DixReadAccess) != Success || !prop ||
+        prop->type != XA_WINDOW || prop->format != 32 || prop->size != 1)
+        return FALSE;
+    id = *(CARD32 *) prop->data;
+    return id != pWin->drawable.id &&
+        CLIENT_ID(id) == CLIENT_ID(pWin->drawable.id) &&
+        dixLookupWindow(&host, id, serverClient, DixReadAccess) == Success &&
+        host->viewable;
+}
+
+typedef struct {
+    WindowPtr popup;
+    BoxRec box;
+} CompPopupArea;
+
+static int
+compFindRetainedPixels(WindowPtr pWin, void *data)
+{
+    CompPopupArea *area = data;
+
+    if (pWin == area->popup || !pWin->viewable ||
+        pWin->redirectDraw == RedirectDrawManual)
+        return WT_DONTWALKCHILDREN;
+    if (pWin->drawable.depth == area->popup->drawable.depth &&
+        RegionContainsRect(&pWin->borderSize, &area->box) != rgnOUT)
+        return WT_STOPWALKING;
+    return WT_WALKCHILDREN;
+}
+
+static Bool
+compShouldClearPopup(WindowPtr pWin, PictFormatPtr format, PixmapPtr pixmap)
+{
+    BoxPtr root;
+    CompPopupArea area;
+
+    if (GetCompWindow(pWin)->update != CompositeRedirectManual ||
+        !pWin->overrideRedirect || pWin->backgroundState != None || pWin->borderWidth ||
+        pWin->parent != pWin->drawable.pScreen->root || pWin->firstChild ||
+        !format || format->type != PictTypeDirect || !format->direct.alphaMask ||
+        !compHasViewableTransient(pWin))
+        return FALSE;
+    /* Clip before narrowing coordinates to BoxRec on large resizes. */
+    root = RegionExtents(&pWin->parent->winSize);
+    area.popup = pWin;
+    area.box = (BoxRec) {
+        max(pixmap->screen_x, root->x1), max(pixmap->screen_y, root->y1),
+        min(pixmap->screen_x + pixmap->drawable.width, root->x2),
+        min(pixmap->screen_y + pixmap->drawable.height, root->y2)
+    };
+    return area.box.x1 >= area.box.x2 || area.box.y1 >= area.box.y2 ||
+        TraverseTree(pWin->parent, compFindRetainedPixels, &area) != WT_STOPWALKING;
+}
