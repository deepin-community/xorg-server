+/*
+ * The view a client other than the window manager sees: one CRTC anchored at
+ * the origin, with the output it scans out.  Every reply about the screen and
+ * every pixel read is derived from it.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a
+ * copy of this software and associated documentation files (the "Software"),
+ * to deal in the Software without restriction, including without limitation
+ * the rights to use, copy, modify, merge, publish, distribute, sublicense,
+ * and/or sell copies of the Software, and to permit persons to whom the
+ * Software is furnished to do so, subject to the following conditions:
+ *
+ * The above copyright notice and this permission notice shall be included in
+ * all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+ * THE COPYRIGHT HOLDER(S) OR AUTHOR(S) BE LIABLE FOR ANY CLAIM, DAMAGES OR
+ * OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE,
+ * ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR
+ * OTHER DEALINGS IN THE SOFTWARE.
+ */
+#include "randrstr.h"
+#include "../dix/dispatch.h"
+
+/* Requests a restricted client may still issue, by protocol number, in the
+ * order randrproto.h lists them: QueryVersion, SelectInput, GetScreenInfo,
+ * GetScreenSizeRange, GetScreenResources, GetOutputInfo, ListOutputProperties,
+ * QueryOutputProperty, GetOutputProperty, GetCrtcInfo, GetCrtcGammaSize,
+ * GetCrtcGamma, GetScreenResourcesCurrent, GetCrtcTransform, GetPanning,
+ * GetOutputPrimary, GetProviders, GetProviderInfo, ListProviderProperties,
+ * QueryProviderProperty, GetProviderProperty, GetMonitors.  Everything else
+ * changes the configuration or leaves the view, and is refused.
+ */
+static const CARD8 rrPrivacyAllowed[] = {
+    0, 4, 5, 6, 8, 9, 10, 11, 15, 20, 22, 23, 25, 27, 28, 31, 32, 33, 36, 37,
+    41, 42,
+};
+
+Bool
+RRPrivacyRequestAllowed(ClientPtr client, int req)
+{
+    unsigned int i;
+
+    if (!screenInfo.screens[0] ||
+        !MeetingPrivacyViewActive(client, screenInfo.screens[0]))
+        return TRUE;
+
+    for (i = 0; i < ARRAY_SIZE(rrPrivacyAllowed); i++)
+        if (rrPrivacyAllowed[i] == req)
+            return TRUE;
+    return FALSE;
+}
+
+/* The single screen a restricted client is shown.  box is where crtc scans
+ * out, in screen coordinates. */
+typedef struct {
+    RRCrtcPtr crtc;
+    RROutputPtr output;
+    BoxRec box;
+} RRPrivacyView;
+
+/* Rectangle a CRTC scans out, in the coordinates of its screen */
+static Bool
+rrPrivacyCrtcBox(RRCrtcPtr crtc, BoxRec *box)
+{
+    int width, height;
+
+    if (!crtc || !crtc->mode)
+        return FALSE;
+
+    RRCrtcGetScanoutSize(crtc, &width, &height);
+    if (width <= 0 || height <= 0)
+        return FALSE;
+
+    box->x1 = crtc->x;
+    box->y1 = crtc->y;
+    box->x2 = box->x1 + width;
+    box->y2 = box->y1 + height;
+    return TRUE;
+}
+
+/* The visible CRTC is the primary output's, or the first enabled one when no
+ * primary output is marked.  FALSE means nothing is lit up, which callers must
+ * treat as "hide everything" rather than fall back to the real layout. */
+static Bool
+rrPrivacyView(ScreenPtr pScreen, RRPrivacyView *view)
+{
+    rrScrPrivPtr pScrPriv;
+    int i;
+
+    if (!pScreen || !(pScrPriv = rrGetScrPriv(pScreen)))
+        return FALSE;
+
+    view->crtc = NULL;
+    view->output = NULL;
+    if (pScrPriv->primaryOutput &&
+        rrPrivacyCrtcBox(pScrPriv->primaryOutput->crtc, &view->box)) {
+        view->crtc = pScrPriv->primaryOutput->crtc;
+        view->output = pScrPriv->primaryOutput;
+        return TRUE;
+    }
+
+    for (i = 0; i < pScrPriv->numCrtcs && !view->crtc; i++)
+        if (rrPrivacyCrtcBox(pScrPriv->crtcs[i], &view->box))
+            view->crtc = pScrPriv->crtcs[i];
+    for (i = 0; i < pScrPriv->numOutputs && !view->output; i++)
+        if (pScrPriv->outputs[i]->crtc == view->crtc)
+            view->output = pScrPriv->outputs[i];
+
+    return view->crtc != NULL;
+}
+
+Bool
+RRPrivacyAnchor(ScreenPtr pScreen, RRCrtcPtr *crtc, RROutputPtr *output,
+                BoxRec *box)
+{
+    RRPrivacyView view;
+
+    if (!rrPrivacyView(pScreen, &view))
+        return FALSE;
+
+    if (crtc)
+        *crtc = view.crtc;
+    if (output)
+        *output = view.output;
+    if (box)
+        *box = view.box;
+    return TRUE;
+}
+
+/*
+ * Geometry of the view: the CRTC box anchored at the origin.  Every advertised
+ * rectangle and every pixel read uses this coordinate space, so the view
+ * starts at 0,0 no matter where the CRTC sits in the real layout.
+ *
+ * This translation is only carried out for the rectangles and the pixels the
+ * view hands out.  Window positions, TranslateCoordinates and the root
+ * coordinates of pointer events stay in the real layout, so a non-zero anchor
+ * origin would leave every client with coordinates that are biased against
+ * the screen it is told it has.  The mode therefore relies on the invariant
+ * that the window manager keeps the anchor CRTC at the origin, which mirroring
+ * does by construction; a layout that breaks it is reported rather than
+ * misplaced silently.
+ */
+Bool
+RRPrivacyViewBox(ScreenPtr pScreen, BoxRec *box)
+{
+    RRPrivacyView view;
+    static Bool warnedOrigin;
+
+    if (!rrPrivacyView(pScreen, &view))
+        return FALSE;
+
+    if ((view.box.x1 != 0 || view.box.y1 != 0) && !warnedOrigin) {
+        warnedOrigin = TRUE;
+        LogMessageVerb(X_WARNING, 0,
+                       "randr: privacy view anchor at %d,%d instead of the "
+                       "origin, client coordinates will be offset\n",
+                       view.box.x1, view.box.y1);
+    }
+
+    box->x1 = 0;
+    box->y1 = 0;
+    box->x2 = view.box.x2 - view.box.x1;
+    box->y2 = view.box.y2 - view.box.y1;
+    return TRUE;
+}
+
+/* Rectangles the pixel view is built from: the view rectangle a client reads
+ * and the first other enabled CRTC box its content comes from. */
+Bool
+RRPrivacyViewBoxes(ScreenPtr pScreen, BoxRec *view, BoxRec *secondary,
+                   Bool *hasSecondary)
+{
+    rrScrPrivPtr pScrPriv = rrGetScrPriv(pScreen);
+    RRPrivacyView anchor;
+    int i;
+
+    *hasSecondary = FALSE;
+    if (!pScrPriv || !rrPrivacyView(pScreen, &anchor) ||
+        !RRPrivacyViewBox(pScreen, view))
+        return FALSE;
+
+    for (i = 0; i < pScrPriv->numCrtcs; i++) {
+        if (pScrPriv->crtcs[i] == anchor.crtc)
+            continue;
+        if (rrPrivacyCrtcBox(pScrPriv->crtcs[i], secondary)) {
+            *hasSecondary = TRUE;
+            break;
+        }
+    }
+    return TRUE;
+}
+
+/* Size a restricted client is told its screen has: the view box in pixels and
+ * the physical size of the anchor output in millimetres when it is known.  The
+ * connection setup block, the root window geometry and the RandR size range
+ * all report this, so none of them hands out the dimensions of the real
+ * layout the view was cut out of. */
+Bool
+RRPrivacyScreenSize(ClientPtr client, ScreenPtr pScreen, int *width,
+                    int *height, int *mmWidth, int *mmHeight)
+{
+    RRPrivacyView view;
+
+    if (!MeetingPrivacyViewActive(client, pScreen) ||
+        !rrPrivacyView(pScreen, &view))
+        return FALSE;
+
+    *width = view.box.x2 - view.box.x1;
+    *height = view.box.y2 - view.box.y1;
+
+    if (view.output && view.output->mmWidth > 0 && view.output->mmHeight > 0) {
+        *mmWidth = view.output->mmWidth;
+        *mmHeight = view.output->mmHeight;
+    }
+    else if (pScreen->width > 0 && pScreen->height > 0) {
+        *mmWidth = pScreen->mmWidth * *width / pScreen->width;
+        *mmHeight = pScreen->mmHeight * *height / pScreen->height;
+    }
+    else {
+        *mmWidth = 0;
+        *mmHeight = 0;
+    }
+    return TRUE;
+}
+
+Bool
+RRPrivacyCrtcHidden(ClientPtr client, RRCrtcPtr crtc)
+{
+    RRPrivacyView view;
+
+    if (!crtc || !crtc->pScreen ||
+        !MeetingPrivacyViewActive(client, crtc->pScreen))
+        return FALSE;
+    if (!rrPrivacyView(crtc->pScreen, &view))
+        return TRUE;
+    return crtc != view.crtc;
+}
+
+Bool
+RRPrivacyOutputHidden(ClientPtr client, RROutputPtr output)
+{
+    RRPrivacyView view;
+
+    if (!output || !output->pScreen ||
+        !MeetingPrivacyViewActive(client, output->pScreen))
+        return FALSE;
+    if (!rrPrivacyView(output->pScreen, &view))
+        return TRUE;
+    return output != view.output;
+}
+
+/* Modes the view advertises: the modes of its output plus the mode its CRTC
+ * scans out, which stays visible even when the output does not list it -- a
+ * mode missing here but named by RRGetOutputInfo makes clients print it as an
+ * unknown mode id.  Returns NULL when out of memory, like RRModesForScreen(). */
+RRModePtr *
+RRPrivacyModes(RROutputPtr output, RRCrtcPtr crtc, int *num)
+{
+    int numModes = output ? output->numModes + output->numUserModes : 0;
+    RRModePtr *modes;
+    int i;
+
+    modes = calloc(numModes + 1, sizeof(RRModePtr));
+    if (!modes)
+        return NULL;
+
+    for (i = 0; i < numModes; i++)
+        modes[i] = i < output->numModes ? output->modes[i]
+            : output->userModes[i - output->numModes];
+
+    if (crtc->mode) {
+        for (i = 0; i < numModes; i++)
+            if (modes[i] == crtc->mode)
+                break;
+        if (i == numModes)
+            modes[numModes++] = crtc->mode;
+    }
+
+    *num = numModes;
+    return modes;
+}
