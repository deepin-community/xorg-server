+#define MEETING_PRIVACY_MODE_ATOM "_DEEPIN_NET_MIRROR_MODE"
+
+/* Set by the window manager through _DEEPIN_NET_MIRROR_MODE on the root
+ * window, 0 = off. */
+Bool
+MeetingPrivacyModeEnabled(ScreenPtr pScreen)
+{
+    Atom atom;
+    PropertyPtr pProp;
+
+    if (!pScreen || !pScreen->root)
+        return FALSE;
+
+    /* Resolved per call, the atom table is rebuilt on server reset. */
+    atom = MakeAtom(MEETING_PRIVACY_MODE_ATOM,
+                    strlen(MEETING_PRIVACY_MODE_ATOM), TRUE);
+
+    if (dixLookupProperty(&pProp, pScreen->root, atom, serverClient,
+                          DixReadAccess) != Success)
+        return FALSE;
+
+    return pProp->format == 32 && pProp->size >= 1 &&
+           ((CARD32 *) pProp->data)[0] != 0;
+}
+
+Bool
+MeetingPrivacyViewActive(ClientPtr client, ScreenPtr pScreen)
+{
+    if (!client || !pScreen || IsClientWindowManager(client, pScreen))
+        return FALSE;
+
+    return MeetingPrivacyModeEnabled(pScreen);
+}
+
+/* TRUE for the drawables that hold the screen content itself */
+Bool
+MeetingPrivacyIsScreenLevel(DrawablePtr pDraw)
+{
+    ScreenPtr pScreen;
+    WindowPtr pWin;
+    int i;
+
+    if (!pDraw || !(pScreen = pDraw->pScreen))
+        return FALSE;
+
+    if (pDraw->type == DRAWABLE_WINDOW) {
+        pWin = (WindowPtr) pDraw;
+        if (pWin == pScreen->root)
+            return TRUE;
+        /* Composite overlay window, covers the whole screen. */
+        return pWin->parent == pScreen->root && pWin->overrideRedirect &&
+               clients[CLIENT_ID(pWin->drawable.id)] == serverClient &&
+               pDraw->x == 0 && pDraw->y == 0 &&
+               pDraw->width == pScreen->width &&
+               pDraw->height == pScreen->height;
+    }
+
+    for (i = 0; i < screenInfo.numScreens; i++) {
+        if ((*screenInfo.screens[i]->GetScreenPixmap) (screenInfo.screens[i]) ==
+            (PixmapPtr) pDraw)
+            return TRUE;
+    }
+
+    return FALSE;
+}
+
+/* Error a read of pDraw has to fail with, Success when it may go on:
+ * screen content belongs to the window manager, a window to its client. */
+static int
+meetingPrivacyReadError(ClientPtr client, DrawablePtr pDraw, int format,
+                        Bool screenView)
+{
+    if (!MeetingPrivacyViewActive(client, pDraw->pScreen))
+        return Success;
+
+    if (MeetingPrivacyIsScreenLevel(pDraw)) {
+        /* A plane cannot be remapped out of the screen content. */
+        if (format == XYPixmap || !screenView)
+            return BadMatch;
+        return Success;
+    }
+
+    if (pDraw->type != DRAWABLE_WINDOW)
+        return Success;
+
+    return clients[CLIENT_ID(pDraw->id)] == client ? Success : BadAccess;
+}
+
+int
+MeetingPrivacyImageError(ClientPtr client, DrawablePtr pDraw, int format)
+{
+    return meetingPrivacyReadError(client, pDraw, format, TRUE);
+}
+
+int
+MeetingPrivacyCopyError(ClientPtr client, DrawablePtr pDraw)
+{
+    return meetingPrivacyReadError(client, pDraw, ZPixmap, FALSE);
+}
+
+/* Replace one band of a read with the matching rectangle of the view, the
+ * request keeps its position and size. */
+void
+MeetingPrivacyFillScreenView(DrawablePtr pDraw, int x, int y, int width,
+                             int height, char *buf)
+{
+    ScreenPtr pScreen = pDraw->pScreen;
+    PixmapPtr pScreenPix;
+    BoxRec view, secondary, band, clip, src;
+    Bool hasSecondary;
+    char *tmp;
+    long stride = PixmapBytePad(width, pDraw->depth);
+    long tmpStride;
+    int bytesPerPixel = pDraw->bitsPerPixel >> 3;
+    int line, sy;
+
+    for (line = 0; line < height; line++)
+        memset(buf + line * stride, 0, stride);
+
+    if (bytesPerPixel < 1 ||
+        !RRPrivacyViewBoxes(pScreen, &view, &secondary, &hasSecondary))
+        return;
+
+    if (!hasSecondary)
+        secondary = view;
+
+    band.x1 = x;
+    band.y1 = y;
+    band.x2 = x + width;
+    band.y2 = y + height;
+    if (band.x1 >= view.x2 || band.x2 <= view.x1 ||
+        band.y1 >= view.y2 || band.y2 <= view.y1)
+        return;
+
+    clip.x1 = max(band.x1, view.x1);
+    clip.y1 = max(band.y1, view.y1);
+    clip.x2 = min(band.x2, view.x2);
+    clip.y2 = min(band.y2, view.y2);
+
+    src.x1 = secondary.x1 + (clip.x1 - view.x1);
+    src.y1 = secondary.y1 + (clip.y1 - view.y1);
+    src.x2 = min(secondary.x1 + (clip.x2 - view.x1), secondary.x2);
+    src.y2 = min(secondary.y1 + (clip.y2 - view.y1), secondary.y2);
+    if (src.x1 >= src.x2 || src.y1 >= src.y2)
+        return;
+
+    tmpStride = PixmapBytePad(src.x2 - src.x1, pDraw->depth);
+    tmp = malloc((size_t) tmpStride * (src.y2 - src.y1));
+    if (!tmp)
+        return;
+
+    pScreenPix = (*pScreen->GetScreenPixmap) (pScreen);
+    (*pScreen->GetImage) (&pScreenPix->drawable, src.x1, src.y1,
+                          src.x2 - src.x1, src.y2 - src.y1, ZPixmap, ~0, tmp);
+
+    for (sy = src.y1; sy < src.y2; sy++) {
+        int destY = clip.y1 + (sy - src.y1) - y;
+        int destX = clip.x1 - x;
+        int span = src.x2 - src.x1;
+
+        if (destY < 0 || destY >= height || destX < 0)
+            continue;
+        if (span > width - destX)
+            span = width - destX;
+        if (span <= 0)
+            continue;
+
+        memcpy(buf + destY * stride + destX * bytesPerPixel,
+               tmp + (sy - src.y1) * tmpStride,
+               (size_t) span * bytesPerPixel);
+    }
+
+    free(tmp);
+}
