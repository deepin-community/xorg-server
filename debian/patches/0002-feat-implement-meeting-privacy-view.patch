+ * shown the view, so the ones that name it answer with the view instead of
+ * the layout it was cut out of.  Returns the CARD32 items to reply with, or
+ * NULL when the property is not one of them. */
+static CARD32 *
+privacyPropertyData(ClientPtr client, WindowPtr pWin, PropertyPtr pProp,
+                    unsigned long *count)
+{
+    static Atom geometry, workarea;
+    int width, height, mmWidth, mmHeight;
+    unsigned long i, desktops;
+    CARD32 *data;
+
+    if (pProp->format != 32)
+        return NULL;
+
+    if (!geometry) {
+        geometry = MakeAtom("_NET_DESKTOP_GEOMETRY",
+                            sizeof("_NET_DESKTOP_GEOMETRY") - 1, FALSE);
+        workarea = MakeAtom("_NET_WORKAREA", sizeof("_NET_WORKAREA") - 1,
+                            FALSE);
+    }
+    if (pProp->propertyName != geometry && pProp->propertyName != workarea)
+        return NULL;
