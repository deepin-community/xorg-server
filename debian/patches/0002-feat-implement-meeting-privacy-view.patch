+        !RRPrivacyScreenSize(client, pWin->drawable.pScreen, &width, &height,
+                             &mmWidth, &mmHeight))
+        return NULL;
+
+    if (pProp->propertyName == geometry) {
+        if (pProp->size < 2)
+            return NULL;
+        *count = 2;
+    }
+    else {
+        desktops = pProp->size / 4;
+        if (!desktops)
+            return NULL;
+        *count = desktops * 4;
+    }
+
+    data = calloc(*count, sizeof(CARD32));
+    if (!data)
+        return NULL;
+
+    if (pProp->propertyName == geometry) {
+        data[0] = width;
+        data[1] = height;
+    }
+    else {
+        /* the work area keeps the struts the window manager reserved, clipped
+         * to the view; the view is anchored at the origin, so the clip is a
+         * plain intersection */
+        memcpy(data, pProp->data, *count * sizeof(CARD32));
+        for (i = 0; i < *count; i += 4) {
+            unsigned long left = data[i], top = data[i + 1];
+            unsigned long right = left + data[i + 2];
+            unsigned long bottom = top + data[i + 3];
+
+            unsigned long x2 = right > (unsigned long) width ?
+                (unsigned long) width : right;
+            unsigned long y2 = bottom > (unsigned long) height ?
+                (unsigned long) height : bottom;
+
+            data[i] = 0;
+            data[i + 1] = 0;
+            data[i + 2] = x2 > left ? x2 - left : 0;
+            data[i + 3] = y2 > top ? y2 - top : 0;
+        }
+    }
